[Unit]
Description=Mammoth Physics AI conversation service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mammoth-physics
EnvironmentFile=/etc/mammoth-physics.env
ExecStart=/usr/bin/python3 /var/www/mammoth-physics/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
